# Dependencies
/node_modules
**/node_modules

# Build output (Vite emits its manifest here — never commit it)
/public/build
**/public/build

# Environment (each app ships its own .env.example; never commit .env)
.env
.env.local
.env.*.local

# Assembled framework copies — regenerated by `npm run assemble`
# (packages/*/src are the canonical source of truth)
/examples/starter/src
/examples/starter/bin

# Standalone @chavajs/cli package — regenerated by `npm run build:cli`
/dist

# Assembled dev staging copy of the framework (monorepo `chava` bootstrap)
/.chava-stage

# Storage / runtime caches
**/storage/logs/*
**/storage/framework/*
**/storage/app/*
**/database/database.sqlite
**/database/playwright.sqlite

# Logs
npm-debug.log*
*.log

# Test coverage
/coverage

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Internal / not for the repo
ROADMAP.md
PHASE8_REPORT.md
ai/
