{
  "name": "@chavajs/core",
  "version": "1.3.5",
  "description": "chavaJs core â€” the Laravel-equivalent container, router, ORM, validation, auth, queue, events, mail, notifications and scheduling, in TypeScript.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./facades": "./src/facades.ts",
    "./orm/*": "./src/orm/*.ts",
    "./http/*": "./src/http/*.ts",
    "./database/*": "./src/database/*.ts",
    "./auth/*": "./src/auth/*.ts",
    "./session/*": "./src/session/*.ts",
    "./queue/*": "./src/queue/*.ts",
    "./events/*": "./src/events/*.ts",
    "./mail/*": "./src/mail/*.ts",
    "./notifications/*": "./src/notifications/*.ts",
    "./validation/*": "./src/validation/*.ts",
    "./container/*": "./src/container/*.ts",
    "./foundation/*": "./src/foundation/*.ts",
    "./support/*": "./src/support/*.ts",
    "./config/*": "./src/config/*.ts",
    "./scheduling/*": "./src/scheduling/*.ts",
    "./docs": "./docs"
  },
  "files": [
    "src",
    "docs",
    "LICENSE"
  ],
  "keywords": [
    "chavajs",
    "laravel",
    "fullstack",
    "orm",
    "typescript",
    "framework"
  ],
  "peerDependencies": {
    "pg": "^8.0.0",
    "mysql2": "^3.0.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.0.0",
    "nodemailer": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "ioredis": {
