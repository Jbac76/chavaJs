# Copy this file to `.env` and adjust for your local environment.
# `chava new` pre-fills DB_CONNECTION/DB_DATABASE for the engine you chose.

APP_NAME=chavaJs
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database (sqlite | pg | mysql)
#   sqlite:  DB_DATABASE is a file path (default database/database.sqlite)
#   pg:      requires `npm i pg`;   DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD
#   mysql:   requires `npm i mysql2`; same variables, port 3306
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSL=false

# Vite dev server
VITE_URL=http://localhost:5173
VITE_PORT=5173

# Queue (sync | database | redis)
QUEUE_CONNECTION=sync
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Mail (log | array | smtp)
MAIL_MAILER=log
MAIL_LOG_PATH=storage/logs/chava-mail.log
MAIL_FROM_ADDRESS=hello@chava.dev
MAIL_FROM_NAME=chavaJs
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
