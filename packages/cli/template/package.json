{
  "name": "chavajs-app",
  "version": "0.0.3",
  "description": "A chavaJs application — the Laravel-equivalent full-stack framework for Node.js",
  "type": "module",
  "license": "MIT",
  "bin": {
    "chava": "bin/chava.js",
    "js": "bin/chava.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "chava": "node bin/chava.js",
    "serve": "js serve",
    "dev": "js serve",
    "migrate": "js migrate",
    "db:seed": "js db:seed",
    "vite": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@faker-js/faker": "10.5.0",
    "@inertiajs/core": "1.3.0",
    "@inertiajs/react": "1.3.0",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "commander": "12.1.0",
    "dotenv": "16.6.1",
    "lucide-react": "0.469.0",
    "motion": "11.18.2",
    "next-themes": "0.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
