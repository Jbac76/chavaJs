{
  "name": "chavajs-starter",
  "version": "0.0.3",
  "private": true,
  "description": "The chavaJs reference application (users/posts/auth/notifications) — the canonical demo the `chava new` template is generated from.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "chava": "bin/chava.js",
    "js": "bin/chava.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "chava": "node bin/chava.js",
    "serve": "js serve",
    "dev": "js serve",
    "migrate": "js migrate",
    "db:seed": "js db:seed",
    "vite": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "test:browser": "playwright test",
    "test:postgres": "node ../../scripts/run-tests-driver.mjs postgres",
    "test:mysql": "node ../../scripts/run-tests-driver.mjs mysql"
  },
  "dependencies": {
    "@inertiajs/core": "^1.3.0",
    "@tanstack/react-table": "^8.20.5",
    "@inertiajs/react": "^1.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.469.0",
    "motion": "^11.15.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "mysql2": "^3.23.2",
    "pg": "^8.23.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.11",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  },
  "peerDependencies": {
    "pg": ">=8.0.0",
    "mysql2": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  }
}
