# chavaJs Docker Development Environment
# Copy this to examples/starter/.env and adjust as needed

APP_NAME=chavaJs
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=

# Database - PostgreSQL (default)
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chava_dev
DB_USERNAME=chava
DB_PASSWORD=chava
DB_SSL=false

# Database - MySQL (alternative)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=chava_dev
# DB_USERNAME=chava
# DB_PASSWORD=chava

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=chava

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Queue
QUEUE_CONNECTION=sync
# For Redis queue: QUEUE_CONNECTION=redis

# Mail - MailHog
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@chava.dev
MAIL_FROM_NAME="${APP_NAME}"

# Vite
VITE_URL=http://localhost:5173
VITE_PORT=5173
